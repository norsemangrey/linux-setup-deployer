#!/bin/bash
# Cloud Client Setup Configuration File
#
# This is an example configuration file for cloud-client-setup.sh
# Copy this file and modify the values according to your setup
# Usage: ./cloud-client-setup.sh --config your-config.conf
# Usage: ./ssh-setup-and-config.sh --config your-config.conf
#
# This file is sourced by the main script, so use proper bash syntax
# Lines starting with # are comments and will be ignored

# ===================================
# PLATFORM AND STEPS
# ===================================

# The platform and environment are detected automatically (see platform.sh).
# Uncomment to override.
# platform: wsl | hyperv | other (bare metal or other hypervisor)
# environment: desktop | headless
#platform="hyperv"
#environment="headless"

# Switches to turn steps on or off. Values: yes, no.
# Leave empty (or 'auto') to use the default for the detected platform/environment.
#
#   setupLocale     Generate locales                           (default: yes, no on desktop)
#   setupSsh        OpenSSH server and key-based login         (default: yes, no on WSL)
#   setupFirewall   UFW package and SSH firewall rule          (default: yes, no on WSL)
#   setupAvahi      Avahi / mDNS                               (default: yes, no on WSL and desktop)
#   setupPass       GPG key, 'pass' and GitHub credentials     (default: yes, no on desktop)
#   setupDotfiles   Clone and run the dotfiles repository      (default: yes)
#   setupWork       Work host share, work cloud symlink and    (default: ask on WSL/Hyper-V, no otherwise)
#                   copy of personal cloud to the host
#
# Note: GitHub credentials (storeGithubCredentials below) require 'pass' and a Git credential helper
# (configured by the dotfiles). They are skipped with a warning if these are not available.
setupLocale=""
setupSsh=""
setupFirewall=""
setupAvahi=""
setupPass=""
setupDotfiles=""
setupWork=""

# ===================================
# PERSONAL CLOUD CONFIGURATION
# ===================================

# Whether to connect to a personal cloud directory (sync/mount).
# Values: y, yes, n, no (case insensitive). Leave empty to be asked (defaults to 'no' on desktop,
# where the client is configured in the UI and only the local directory below is created).
connectCloud="y"

# Whether to continue if local cloud directory has content
# Values: y, Y, yes, n, N, no (case insensitive)
continueWithContent="n"

# Connection method for personal cloud
# Values: m (mount using WebDav), s (sync using Nextcloud CLI)
connectMethod="s"

# ===================================
# CLOUD CONFIGURATION
# ===================================

# Nextcloud server address (without https://)
cloudAddress="cloud.example.com"

# Nextcloud username
cloudUsername="user"

# Nextcloud password (consider security implications)
#cloudPassword="your-password"

# ===================================
# SMB SHARE CONFIGURATION
# ===================================

# The SMB share is mounted when 'setupWork' (above) is enabled on a platform other than WSL.
# On WSL the Windows drive is already mounted (use '/mnt/c' as the mount point).

# SMB server IP address or hostname
smbHost="192.168.0.100"

# SMB share name (examples: c$, d$, shared, documents, public)
smbShare="public"

# Local mount point for the SMB share
smbMountPoint="/mnt/smb"

# SMB username
smbUsername="user@kexample.com"

# SMB password (consider security implications)
#smbPassword="your-smb-password"

# ===================================
# PATH CONFIGURATION
# ===================================

# Local cloud directory path (where personal cloud files are stored locally)
localCloudPath="${HOME}/cloud/personal"

# Local path where SMB cloud files will be accessed/symlinked
# This creates a local symlink to access the work cloud directory from your home folder
localFromSmbCloudPath="${HOME}/cloud/remote"

# SMB share cloud directory path (work cloud directory on the remote share)
# This is a relative path on the SMB share pointing to the work cloud directory
smbCloudPath="Cloud/remote"

# SMB share path where personal cloud files will be synced
# This is a relative path on the SMB share where personal cloud files will be copied/synced
smbFromLocalCloudPath="Cloud/personal"

# ===================================
# GPG CONFIGURATION
# ===================================

# GPG key type (RSA, DSA, ECDSA, etc.)
gpgKeyType="RSA"

# GPG key length in bits
gpgKeyLength="4096"

# Real name for GPG key
gpgNameReal="User"

# Email address for GPG key
gpgNameEmail="user@example.com"

# GPG key expiration (0 = never expires)
gpgExpireDate="0"

# ===================================
# GITHUB SETTINGS
# ===================================

# Whether to store GitHub credentials for HTTPS operations
# Values: y, Y, n, N (case insensitive)
storeGithubCredentials="y"

# Path to your personal repositories directory (used for local clones)
personalReposPath="${HOME}/workspace/personal/repos"

# Your GitHub username (used for cloning and credential setup)
personalGithubUser="someuser"

# Your GitHub Personal Access Token (PAT) for HTTPS operations
# Should start with 'gho_'. Leave blank to be prompted during setup.
#personalGithubToken=""

# ===================================
# SECURITY NOTES
# ===================================
#
# WARNING: This configuration file contains sensitive information including passwords.
# Ensure proper file permissions are set:
#   chmod 600 your-config.conf
#
# Consider using environment variables or a secure credential store for passwords
# in production environments.
#
# Since this file is sourced, you can also use:
# - Environment variable expansion: cloudUsername="${USER}"
# - Command substitution: smbHost="$(hostname -I | awk '{print $1}')"
# - Conditional logic: [[ -f ~/.secret ]] && source ~/.secret
